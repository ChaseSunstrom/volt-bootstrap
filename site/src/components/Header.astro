---
// The site's one header (Starlight's Header, overridden in astro.config.mjs): the landing page is a
// Starlight page too, so the docs and the landing page share this: the mark and wordmark, the main
// sections, Starlight's search, its theme switch and the GitHub link.
import Search from "virtual:starlight/components/Search";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = Astro.url.pathname;
const links = [
  { label: "Learn", href: `${base}/start/install/`, section: "/start/" },
  { label: "Guide", href: `${base}/guide/basics/`, section: "/guide/" },
  { label: "std", href: `${base}/std/overview/`, section: "/std/" },
  { label: "bolt", href: `${base}/bolt/overview/`, section: "/bolt/" },
  { label: "Interop", href: `${base}/interop/c/`, section: "/interop/" },
];
// the mark: a signal trace bent into a V, and the spark at its leading end (assets/logo/logo.ts
// writes src/assets/volt-mark.svg)
const markSvg = readFileSync(resolve(process.cwd(), "src/assets/volt-mark.svg"), "utf8");
const trace = markSvg.match(/<path d="([^"]+)"/)![1];
const [cx, cy, r] = ["cx", "cy", "r"].map((a) => markSvg.match(new RegExp(`<circle[^>]* ${a}="([^"]+)"`))![1]);
---

<div class="v-header">
  <a class="v-brand" href={`${base}/`}>
    <svg viewBox="0 22 100 56" aria-hidden="true">
      <path class="v-trace" d={trace} pathLength="1" />
      <circle class="v-spark" cx={cx} cy={cy} r={r} style={`--trace: path("${trace} H ${cx}")`} />
    </svg>
    <span>volt</span>
  </a>
  <nav class="v-links" aria-label="Sections">
    {links.map((l) => <a href={l.href} aria-current={here.includes(l.section) ? "true" : undefined}>{l.label}</a>)}
  </nav>
  <div class="v-search print:hidden">
    <Search />
  </div>
  <div class="v-right print:hidden">
    <SocialIcons />
    <ThemeSelect />
  </div>
</div>

<style>
  .v-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 100%;
  }
  .v-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--sl-color-white);
    flex-shrink: 0;
  }
  .v-brand svg {
    width: 2.6rem;
    height: auto;
    overflow: visible;
  }
  .v-trace {
    fill: none;
    stroke: var(--v-mark);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .v-spark {
    fill: var(--v-spark);
  }
  .v-brand span {
    font-family: var(--v-sans);
    font-variation-settings: "wdth" 88, "opsz" 48;
    font-weight: 750;
    font-size: 1.45rem;
    letter-spacing: -0.035em;
  }
  /* the trace sweeps in like a scope's beam with the spark at its head: on the landing page's first
     load (data-intro), and again when the mark is hovered */
  @keyframes v-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes v-ride {
    from { offset-distance: 0%; }
    to { offset-distance: 100%; }
  }
  :global(:root[data-intro]) .v-trace,
  .v-brand:hover .v-trace {
    stroke-dasharray: 1;
    animation: v-draw 0.9s var(--v-ease) both;
  }
  :global(:root[data-intro]) .v-spark,
  .v-brand:hover .v-spark {
    offset-path: var(--trace);
    offset-rotate: 0deg;
    animation: v-ride 0.9s var(--v-ease) both;
    cx: 0;
    cy: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(:root[data-intro]) .v-trace,
    :global(:root[data-intro]) .v-spark,
    .v-brand:hover .v-trace,
    .v-brand:hover .v-spark {
      animation: none;
      stroke-dasharray: none;
      offset-path: none;
    }
  }
  .v-links {
    display: none;
    gap: 0.25rem;
  }
  .v-links a {
    padding: 0.35rem 0.6rem;
    border-radius: 0.3rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .v-links a:hover {
    color: var(--sl-color-white);
  }
  .v-links a[aria-current="true"] {
    color: var(--sl-color-white);
    box-shadow: inset 0 -2px 0 var(--sl-color-accent);
    border-radius: 0;
  }
  .v-search {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }
  .v-right {
    display: none;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 50rem) {
    .v-links,
    .v-right {
      display: flex;
    }
    .v-search {
      justify-content: center;
    }
  }
</style>
