---
// The landing page: a Starlight page (so it shares the docs' header, search and theme) with its own
// sections. Code samples are the programs in src/samples, which tests/docs.rs compiles and runs;
// their `// expect:` lines are the output shown. The benchmark bars come from the table in
// internals/benchmarks.md, which a benchmark run rewrites.
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Code } from "astro:components";
import { volt, boardDark as board } from "../code-themes.mjs";
import "../styles/landing.css";
import heroSrc from "../samples/hero.volt?raw";
// what voltc writes for the hero program, excerpts that tests/docs.rs finds in `voltc emit-c` and
// `voltc emit-llvm` (a debug build)
import heroC from "../samples/hero.c.txt?raw";
import heroLlvm from "../samples/hero.ll.txt?raw";
import errorsSrc from "../samples/errors.volt?raw";
import ownershipSrc from "../samples/ownership.volt?raw";
import templatesSrc from "../samples/templates.volt?raw";
import comptimeSrc from "../samples/comptime.volt?raw";
import interopSrc from "../samples/interop.volt?raw";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const doc = (path: string) => `${base}/${path}/`;

// a sample's code (without its expect lines) and its output
function sample(src: string) {
  const lines = src.trimEnd().split("\n");
  const output = lines.filter((l) => l.startsWith("// expect:")).map((l) => l.slice("// expect:".length).trim());
  const code = lines.filter((l) => !l.startsWith("// expect:")).join("\n").trimEnd();
  return { code, output };
}

const hero = sample(heroSrc);

const tabs = [
  {
    id: "errors",
    label: "Errors",
    title: "Errors are values",
    text: "A function that can fail returns E!T: an error from the set E, or a T. try passes an error up, catch handles it. Optionals (T?) say a value may be missing, and ?? gives a fallback. Nothing is thrown, nothing unwinds.",
    link: doc("guide/errors"),
    ...sample(errorsSrc),
  },
  {
    id: "ownership",
    label: "Ownership",
    title: "Ownership without a collector",
    text: "Every value has one owner and is deleted when that owner's scope ends, in reverse order. Passing a value moves it (using it afterwards is a compile error); copy makes a second owner.",
    link: doc("guide/ownership"),
    ...sample(ownershipSrc),
  },
  {
    id: "templates",
    label: "Templates",
    title: "Templates and closed traits",
    text: "Generic functions and structs are templates: one copy per set of arguments. A trait used as a type is a tagged union of every type that attaches it, so a call is a switch, never a vtable.",
    link: doc("guide/templates"),
    ...sample(templatesSrc),
  },
  {
    id: "comptime",
    label: "Comptime",
    title: "Code that runs while compiling",
    text: "comptime functions, comptime if, for and match, types as values and @typeinfo. Here fib runs in the compiler, and a pack of arguments unrolls into one print per type.",
    link: doc("guide/comptime"),
    ...sample(comptimeSrc),
  },
  {
    id: "interop",
    label: "C and C++",
    title: "C and C++ headers, imported",
    text: "A use line reads real C headers, and C++ ones through libclang: classes with their layouts, constructors, methods, overloads and templates. Rust and Zig files import the same way.",
    link: doc("interop/cpp"),
    ...sample(interopSrc),
  },
];

// the benchmark table: each program's Volt times as a fraction of C's (clang -O2)
const benchMd = readFileSync(resolve(process.cwd(), "src/content/docs/internals/benchmarks.md"), "utf8");
const ratio = (cell: string) => parseFloat(cell.match(/\(([\d.]+)x\)/)?.[1] ?? "1");
const bench = benchMd
  .split("<!-- bench:start -->")[1]
  .split("<!-- bench:end -->")[0]
  .split("\n")
  .filter((l) => /^\| [a-z0-9_]+ \|/.test(l))
  .map((l) => {
    const cells = l.split("|").map((c) => c.trim());
    return { name: cells[1], c: ratio(cells[5]), llvm: ratio(cells[6]) };
  });
const scale = 1.4; // the bar area spans 0x to 1.4x of C's time
const pct = (r: number) => `${(Math.min(r, scale) / scale) * 100}%`;

const parts = [
  { ref: "GC1", part: "Garbage collector" },
  { ref: "EX1", part: "Exceptions and unwinding" },
  { ref: "VT1", part: "Virtual tables" },
  { ref: "RT1", part: "Runtime type information" },
  { ref: "AL1", part: "Hidden allocations" },
];

const imports = [
  { lang: "C", line: 'use { "stdio.h" } as c;' },
  { lang: "C++", line: 'use { "shapes.hpp" } as shapes;' },
  { lang: "Rust", line: 'use { "geom.rs" } as geom;' },
  { lang: "Zig", line: 'use { "fastmath.zig" } as fm;' },
];
const callers = ["C", "C++", "Rust", "Zig", "Go", "Python", "JavaScript", "TypeScript", "Lua", "Ruby", "Java", "Kotlin", "C#", "Dart", "Swift"];

const spec = [
  { term: "No runtime", text: "No collector, no scheduler, no vtables, no exceptions. A Volt program is the code you wrote and the standard library you called." },
  { term: "Two backends", text: "Readable C that any C compiler builds, or native code through LLVM. A library from one links with a program from the other." },
  { term: "Checked in debug", text: "Overflow, out-of-bounds indexing, null unwraps and double frees stop with a message and the line. Release builds drop the checks." },
  { term: "Ownership", text: "Deletes run at scope end, moves are tracked, copies are explicit, and box<T> owns heap memory. No annotations." },
  { term: "Comptime", text: "Run code in the compiler, pass types around as values, and read any type's shape with @typeinfo." },
  { term: "Async", text: "Stackless frames of known size, driven with async, resume and await. No heap and no executor." },
  { term: "bolt", text: "The build tool: packages, workspaces, git dependencies, features, profiles, tests, benchmarks and a profiler." },
  { term: "Tooling", text: "A language server built on the compiler, a VS Code extension, and diagnostics that show the code and suggest the fix." },
  { term: "Self-hosted", text: "voltc is written in Volt and builds itself, byte for byte, through both backends." },
];
---

<StarlightPage
  frontmatter={{
    title: "Volt",
    description: "Volt is a compiled systems language with no runtime: ownership instead of a garbage collector, errors as values, templates, comptime, and direct calls into C, C++, Rust and Zig. It compiles to readable C or through LLVM.",
    template: "splash",
    pagefind: false,
    editUrl: false,
    lastUpdated: false,
    prev: false,
    next: false,
    tableOfContents: false,
  }}
>
  <div class="landing not-content">
    <section class="hero">
      <div class="hero-text">
        <h1>A systems language that shows its work.</h1>
        <p class="lede">
          Volt has no runtime. It gives you ownership instead of a garbage collector, errors as values, templates and
          compile-time code, and it compiles to C you can read or to native code through LLVM.
        </p>
        <div class="actions">
          <a class="button primary" href={doc("start/install")}>Install Volt</a>
          <a class="button" href={doc("start/tour")}>Take the tour</a>
        </div>
      </div>

      <div class="board" aria-label="A Volt program, the C voltc writes for it, and what it prints">
        <figure class="chip chip-src">
          <figcaption><span class="ref">U1</span> main.volt</figcaption>
          <Code code={hero.code} lang={volt} theme={board} />
        </figure>
        <svg class="trace t1" viewBox="0 0 64 120" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 40 H 24 L 40 56 H 64" pathLength="1" />
          <circle r="3.5" class="spark" opacity="0">
            <set attributeName="opacity" to="1" begin="0.25s" />
            <animateMotion dur="0.7s" begin="0.25s" fill="freeze" path="M0 40 H 24 L 40 56 H 64" />
          </circle>
        </svg>
        <figure class="chip chip-out">
          <input type="radio" name="backend" id="be-c" checked />
          <input type="radio" name="backend" id="be-llvm" />
          <figcaption>
            <span class="ref">U2</span>
            <span class="switch" role="group" aria-label="Backend">
              <label for="be-c">main.c</label>
              <label for="be-llvm">LLVM IR (debug)</label>
            </span>
          </figcaption>
          <div class="out out-c"><Code code={heroC.trimEnd()} lang="c" theme={board} /></div>
          <div class="out out-llvm"><Code code={heroLlvm.trimEnd()} lang="llvm" theme={board} /></div>
        </figure>
        <svg class="trace t2" viewBox="0 0 64 120" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 56 H 20 L 36 40 H 64" pathLength="1" />
          <circle r="3.5" class="spark" opacity="0">
            <set attributeName="opacity" to="1" begin="1.6s" />
            <animateMotion dur="0.6s" begin="1.6s" fill="freeze" path="M0 56 H 20 L 36 40 H 64" />
          </circle>
        </svg>
        <figure class="chip chip-term">
          <figcaption><span class="ref">J1</span> terminal</figcaption>
          <pre><span class="cmd"><span class="prompt">$</span> voltc run main.volt</span>
<span class="result">{hero.output.join("\n")}</span></pre>
        </figure>
      </div>
    </section>

    <section class="parts">
      <div class="narrow">
        <h2>Left off the board</h2>
        <p>
          Volt programs carry no machinery you didn't ask for. What a line does is what it says, and the C it becomes is
          there to read.
        </p>
      </div>
      <table class="bom">
        <thead><tr><th scope="col">Ref</th><th scope="col">Part</th><th scope="col">Fitted</th></tr></thead>
        <tbody>
          {parts.map((p) => <tr><td>{p.ref}</td><td>{p.part}</td><td>no</td></tr>)}
        </tbody>
      </table>
    </section>

    <section class="samples">
      <h2>Read some Volt</h2>
      <p class="narrow">Every program here is real: the site's tests compile and run each one and check what it prints.</p>
      <div class="tabs">
        {tabs.map((t, i) => <input type="radio" name="sample" id={`s-${t.id}`} checked={i === 0} />)}
        <div class="tab-labels" role="tablist">
          {tabs.map((t) => <label for={`s-${t.id}`} role="tab">{t.label}</label>)}
        </div>
        {tabs.map((t) => (
          <div class={`panel panel-${t.id}`} role="tabpanel">
            <Code code={t.code} lang={volt} theme={board} />
            <div class="panel-text">
              <h3>{t.title}</h3>
              <p>{t.text}</p>
              <pre class="printed">{t.output.join("\n")}</pre>
              <a href={t.link}>Read the guide</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bench">
      <div class="narrow">
        <h2>Measured against C</h2>
        <p>
          Each program runs in C, in C++ and in Volt through both backends. A bar is Volt's time as a share of the C
          program's; the line marks C. Where Volt is faster, it's for a reason you can read: free lists in the default
          allocator, sorting by template instead of a function pointer, Ryu for printing floats.
        </p>
      </div>
      <div class="chart" role="table" aria-label="Volt's time as a share of C's, per benchmark" style={`--c:${pct(1)}`}>
        <div class="chart-head" role="row">
          <span role="columnheader">Program</span>
          <span role="columnheader">Volt, C backend</span>
          <span role="columnheader">Volt, LLVM</span>
        </div>
        {bench.map((b) => (
          <div class="chart-row" role="row">
            <span class="prog" role="rowheader">{b.name}</span>
            <span class="bar-cell" role="cell">
              <span class="track"><span class="bar" style={`--w:${pct(b.c)}`} data-faster={b.c < 0.97 ? "" : undefined}></span></span>
              <span class="num">{b.c.toFixed(2)}×</span>
            </span>
            <span class="bar-cell" role="cell">
              <span class="track"><span class="bar" style={`--w:${pct(b.llvm)}`} data-faster={b.llvm < 0.97 ? "" : undefined}></span></span>
              <span class="num">{b.llvm.toFixed(2)}×</span>
            </span>
          </div>
        ))}
      </div>
      <a href={doc("internals/benchmarks")}>The programs, the machine and every number</a>
    </section>

    <section class="interop">
      <h2>Calls everything, and everything calls it</h2>
      <div class="two">
        <div>
          <h3>Volt imports</h3>
          <p>A use line reads the other language's code like a header. The extension says which language it is.</p>
          <ul class="imports">
            {imports.map((i) => <li><span>{i.lang}</span><code>{i.line}</code></li>)}
          </ul>
        </div>
        <div>
          <h3>Called from</h3>
          <p>
            A Volt library builds as a shared library, and bolt writes its bindings, so each of these calls it the way it
            calls its own libraries.
          </p>
          <p class="langs">{callers.join(", ")}.</p>
        </div>
      </div>
      <a href="https://github.com/ChaseSunstrom/volt-bootstrap/tree/main/examples/interop">A runnable example for each language</a>
    </section>

    <section class="spec">
      <h2>What's in it</h2>
      <dl>
        {spec.map((s) => <div><dt>{s.term}</dt><dd>{s.text}</dd></div>)}
      </dl>
    </section>

    <section class="start">
      <h2>Write your first program</h2>
      <p>Build the compiler, then let bolt make a package and run it.</p>
      <pre class="shell"><span class="prompt">$</span> bolt new hello && cd hello && bolt run</pre>
      <div class="actions">
        <a class="button primary" href={doc("start/install")}>Install Volt</a>
        <a class="button" href={doc("guide/basics")}>Read the guide</a>
      </div>
    </section>

    <footer class="foot">
      <span>Volt is licensed under MIT or Apache-2.0.</span>
      <a href="https://github.com/ChaseSunstrom/volt-bootstrap">Source on GitHub</a>
    </footer>
  </div>
</StarlightPage>
