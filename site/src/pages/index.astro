---
// The landing page: its own layout (the docs use Starlight's). Code samples are the programs in
// src/samples, which tests/docs.rs compiles and runs; their `// expect:` lines are the output shown.
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { Code } from "astro:components";
import "../styles/landing.css";
import errorsSrc from "../samples/errors.volt?raw";
import ownershipSrc from "../samples/ownership.volt?raw";
import templatesSrc from "../samples/templates.volt?raw";
import comptimeSrc from "../samples/comptime.volt?raw";
import interopSrc from "../samples/interop.volt?raw";

const grammar = JSON.parse(readFileSync(resolve(process.cwd(), "../editors/vscode/syntaxes/volt.tmLanguage.json"), "utf8"));
const volt = { ...grammar, name: "volt" };
// the logo's bolt (assets/logo/logo.ts writes it), in a 100×100 box
const bolt = readFileSync(resolve(process.cwd(), "src/assets/volt-bolt.svg"), "utf8").match(/<path d="([^"]+)"/)![1];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const doc = (path: string) => `${base}/${path}/`;

// a sample's code (without its expect lines) and its output
function sample(src: string) {
  const lines = src.trimEnd().split("\n");
  const output = lines.filter((l) => l.startsWith("// expect:")).map((l) => l.slice("// expect:".length).trim());
  const code = lines.filter((l) => !l.startsWith("// expect:")).join("\n").trimEnd();
  return { code, output };
}

const tabs = [
  {
    id: "errors",
    label: "Errors",
    file: "errors.volt",
    title: "Errors are values",
    text: "A function that can fail returns E!T: an error from the set E, or a T. try passes an error up, catch handles it. Optionals (T?) say a value may be missing, and ?? gives a fallback. Nothing is thrown, nothing unwinds.",
    link: doc("guide/errors"),
    ...sample(errorsSrc),
  },
  {
    id: "ownership",
    label: "Ownership",
    file: "ownership.volt",
    title: "Ownership without a collector",
    text: "Every value has one owner and is deleted when that owner's scope ends, in reverse order. Passing a value moves it (using it afterwards is a compile error); copy makes a second owner, through a copy hook when the type needs one.",
    link: doc("guide/ownership"),
    ...sample(ownershipSrc),
  },
  {
    id: "templates",
    label: "Templates & traits",
    file: "templates.volt",
    title: "Templates and closed traits",
    text: "Generic functions and structs are templates: one copy per set of arguments, with specialization, packs and constant parameters. A trait used as a type becomes a tagged union of every type that attaches it, so a call is a switch, never a vtable.",
    link: doc("guide/templates"),
    ...sample(templatesSrc),
  },
  {
    id: "comptime",
    label: "Comptime",
    file: "comptime.volt",
    title: "Code that runs while compiling",
    text: "comptime fns, comptime if, for and match, types as values and @typeinfo. Here fib runs in the compiler, and a pack of arguments unrolls into one print per type.",
    link: doc("guide/comptime"),
    ...sample(comptimeSrc),
  },
  {
    id: "interop",
    label: "C & C++",
    file: "interop.volt",
    title: "C and C++, directly",
    text: "use reads real C headers; use cpp reads C++ headers through libclang: classes with their layouts, constructors, methods, overloads and templates. Other languages call Volt through export fns and generated bindings.",
    link: doc("interop/cpp"),
    ...sample(interopSrc),
  },
];

const features = [
  { icon: "zap", title: "No runtime", text: "No garbage collector, no vtables, no exceptions, no scheduler. What you write is what runs." },
  { icon: "layers", title: "Two backends", text: "Readable C that any C compiler builds, or native code through LLVM. Libraries from one link with programs from the other." },
  { icon: "shield", title: "Checked in debug", text: "Overflow, out-of-bounds indexing, null unwraps and double frees stop with a message. Release builds drop the checks." },
  { icon: "box", title: "Ownership & RAII", text: "Deletes run at scope end, moves are tracked, copies are explicit. box<T> owns heap memory." },
  { icon: "cpu", title: "Comptime", text: "Run code in the compiler, pass types around as values, and read any type's shape with @typeinfo." },
  { icon: "clock", title: "Async without a runtime", text: "Stackless frames of known size, driven by hand with async, resume and await. No heap, no executor." },
  { icon: "plug", title: "Talks to everything", text: "C headers, C++ classes and the C++ standard library, Rust, Zig and Go code, Python, Java, .NET and Lua in; shared libraries with bindings for fifteen languages out." },
  { icon: "package", title: "bolt", text: "The build tool: packages, workspaces, git dependencies, features, profiles, tests, benches and build files." },
  { icon: "repeat", title: "Self-hosted", text: "voltc is written in Volt and builds itself, byte for byte, through both backends." },
];

const icons: Record<string, string> = {
  zap: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  layers: '<path d="m12 2 10 5-10 5L2 7l10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  box: '<path d="M21 16V8l-9-5-9 5v8l9 5 9-5z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  cpu: '<rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  plug: '<path d="M9 2v6M15 2v6"/><path d="M6 8h12v4a6 6 0 0 1-12 0V8z"/><path d="M12 18v4"/>',
  package: '<path d="m7.5 4.3 9 5.2"/><path d="M21 16V8l-9-5-9 5v8l9 5 9-5z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  repeat: '<path d="m17 1 4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="m7 23-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>',
};

const boltToml = `[package]
name = "hello"
version = "0.1.0"

[dependencies]
json = { git = "https://example.com/json.git", tag = "v1.2" }

[features]
default = ["color"]
color = []

[profile.release]
backend = "llvm"`;

const languages = ["C", "C++", "Rust", "Zig", "Python", "JavaScript", "TypeScript", "C#", "Java", "Go", "Lua", "Dart", "Swift", "Kotlin", "Ruby"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Volt: a systems language with nothing hidden</title>
    <meta name="description" content="Volt is a compiled systems language with no runtime: ownership instead of a garbage collector, errors as values, templates, comptime, and C and C++ interop. It compiles to readable C or through LLVM." />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#070a16" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={`${base}/`} aria-label="Volt home">
        <svg viewBox="0 0 100 100" class="brand-mark" aria-hidden="true">
          <defs>
            <linearGradient id="nav-tile" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#312E81" /><stop offset="1" stop-color="#0F172A" /></linearGradient>
            <linearGradient id="nav-bolt" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FDE047" /><stop offset="1" stop-color="#F59E0B" /></linearGradient>
          </defs>
          <rect width="100" height="100" rx="22" fill="url(#nav-tile)" />
          <path d={bolt} transform="translate(17 17) scale(0.66)" fill="url(#nav-bolt)" />
        </svg>
        <span>volt</span>
      </a>
      <nav>
        <a href={doc("start/why")}>Why Volt</a>
        <a href={doc("start/install")}>Docs</a>
        <a href={doc("guide/basics")}>Guide</a>
        <a href={doc("std/overview")}>std</a>
        <a href={doc("bolt/overview")}>bolt</a>
        <a class="gh" href="https://github.com/ChaseSunstrom/volt-bootstrap">GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-bg" aria-hidden="true">
          <div class="orb orb-a"></div>
          <div class="orb orb-b"></div>
          <div class="grid"></div>
          <svg class="traces" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
            <path d="M0 120 H 260 L 320 180 H 520" />
            <path d="M1200 90 H 930 L 870 150 H 700" />
            <path d="M0 470 H 180 L 250 400 H 430" />
            <path d="M1200 500 H 1010 L 950 440 H 760" />
            <path d="M600 600 V 520 L 560 480 V 430" />
            <path class="spark" d="M0 120 H 260 L 320 180 H 520" />
            <path class="spark s2" d="M1200 90 H 930 L 870 150 H 700" />
            <path class="spark s3" d="M0 470 H 180 L 250 400 H 430" />
            <path class="spark s4" d="M1200 500 H 1010 L 950 440 H 760" />
          </svg>
        </div>

        <div class="hero-inner">
          <svg class="hero-mark" viewBox="0 0 100 100" aria-hidden="true">
            <defs>
              <linearGradient id="hero-tile" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#312E81" /><stop offset="1" stop-color="#0F172A" /></linearGradient>
              <linearGradient id="hero-bolt" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FDE047" /><stop offset="1" stop-color="#F59E0B" /></linearGradient>
              <filter id="hero-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3.5" /></filter>
            </defs>
            <rect class="tile" width="100" height="100" rx="22" fill="url(#hero-tile)" />
            <path class="glow" d={bolt} transform="translate(17 17) scale(0.66)" fill="#FBBF24" filter="url(#hero-glow)" />
            <path class="bolt-fill" d={bolt} transform="translate(17 17) scale(0.66)" fill="url(#hero-bolt)" />
            <path class="bolt-line" d={bolt} transform="translate(17 17) scale(0.66)" fill="none" stroke="#FDE047" stroke-width="3.5" stroke-linejoin="round" pathLength="1" />
          </svg>
          <p class="eyebrow">A systems language · compiles to C and LLVM · builds itself</p>
          <h1>Systems programming<br /><span class="charged">with nothing hidden.</span></h1>
          <p class="lede">
            Volt has no runtime: ownership instead of a garbage collector, errors as values, templates and
            compile-time code, and C and C++ within reach. It compiles to readable C or to native code through
            LLVM, and comes with its own build tool.
          </p>
          <div class="cta">
            <a class="btn primary" href={doc("start/install")}>Get started</a>
            <a class="btn ghost" href={doc("start/tour")}>Take the tour</a>
            <a class="btn ghost" href={doc("start/why")}>Why Volt?</a>
          </div>
          <div class="install" aria-label="Create and run a program">
            <span class="prompt">$</span> bolt new hello <span class="op">&amp;&amp;</span> cd hello <span class="op">&amp;&amp;</span> bolt run
          </div>
        </div>
      </section>

      <section class="strip reveal" aria-label="What Volt leaves out">
        <span>No garbage collector</span><span>No vtables</span><span>No exceptions</span><span>No hidden allocations</span><span>No runtime type info</span>
      </section>

      <section class="showcase reveal" id="showcase">
        <h2>A taste of Volt</h2>
        <p class="section-lede">Every sample here is a real program: the site's tests compile and run each one and check its output.</p>
        <div class="tabs">
          {tabs.map((t, i) => <input type="radio" name="tab" id={`tab-${t.id}`} checked={i === 0} />)}
          <div class="tab-labels" role="tablist">
            {tabs.map((t) => <label for={`tab-${t.id}`} role="tab">{t.label}</label>)}
          </div>
          {tabs.map((t) => (
            <div class={`panel panel-${t.id}`} role="tabpanel">
              <div class="window">
                <div class="window-bar"><i></i><i></i><i></i><span>{t.file}</span></div>
                <Code code={t.code} lang={volt} theme="tokyo-night" />
              </div>
              <div class="panel-text">
                <h3>{t.title}</h3>
                <p>{t.text}</p>
                <div class="output">
                  <div class="output-bar">output</div>
                  <pre>{t.output.join("\n")}</pre>
                </div>
                <a class="more" href={t.link}>Read more →</a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="pipeline reveal">
        <h2>One front end, two back ends</h2>
        <p class="section-lede">
          The checker lowers each function to a small typed IR. One backend writes C you can read, split into a
          header and a file per module; the other drives LLVM directly. Both agree on every layout and calling
          convention, and the compiler rebuilds itself through each.
        </p>
        <svg class="flow" viewBox="0 0 960 300" role="img" aria-label="Volt source goes through the parser and checker into a typed IR, then to C or LLVM, then to an executable">
          <defs>
            <linearGradient id="flow-line" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#6366F1" /><stop offset="1" stop-color="#F59E0B" /></linearGradient>
          </defs>
          <g class="links">
            <path d="M150 150 H 210" /><path d="M350 150 H 410" /><path d="M550 150 C 580 150 580 80 610 80" /><path d="M550 150 C 580 150 580 220 610 220" />
            <path d="M750 80 C 780 80 780 150 810 150" /><path d="M750 220 C 780 220 780 150 810 150" />
          </g>
          <g class="pulses">
            <path d="M150 150 H 210" /><path d="M350 150 H 410" /><path d="M550 150 C 580 150 580 80 610 80" /><path d="M550 150 C 580 150 580 220 610 220" />
            <path d="M750 80 C 780 80 780 150 810 150" /><path d="M750 220 C 780 220 780 150 810 150" />
          </g>
          <g class="nodes">
            <g transform="translate(10 115)"><rect width="140" height="70" rx="14" /><text x="70" y="32">source</text><text class="sub" x="70" y="52">.volt files</text></g>
            <g transform="translate(210 115)"><rect width="140" height="70" rx="14" /><text x="70" y="32">parse + check</text><text class="sub" x="70" y="52">types, moves, comptime</text></g>
            <g transform="translate(410 115)"><rect class="hot" width="140" height="70" rx="14" /><text x="70" y="32">typed IR</text><text class="sub" x="70" y="52">per function</text></g>
            <g transform="translate(610 45)"><rect width="140" height="70" rx="14" /><text x="70" y="32">C</text><text class="sub" x="70" y="52">readable, multi-file</text></g>
            <g transform="translate(610 185)"><rect width="140" height="70" rx="14" /><text x="70" y="32">LLVM</text><text class="sub" x="70" y="52">native code</text></g>
            <g transform="translate(810 115)"><rect width="140" height="70" rx="14" /><text x="70" y="32">executable</text><text class="sub" x="70" y="52">or a library</text></g>
          </g>
        </svg>
      </section>

      <section class="features reveal">
        <h2>Small language, sharp tools</h2>
        <div class="feature-grid">
          {features.map((f) => (
            <article class="feature">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} />
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="diagnostics reveal">
        <div class="split">
          <div>
            <h2>Errors that point at the problem</h2>
            <p class="section-lede">
              Every diagnostic shows the code it's about, labels the places that led to it, and suggests the name you
              probably meant. Checking continues past an error, so one run reports every independent mistake. Short
              and JSON formats are there for tools.
            </p>
            <a class="more" href={doc("voltc/diagnostics")}>Diagnostics in depth →</a>
          </div>
          <div class="window term">
            <div class="window-bar"><i></i><i></i><i></i><span>voltc check</span></div>
            <pre class="diag"><b class="err">error</b><b>: 'items' was moved earlier (by move, an assignment, an argument or a return), so it can't be used here</b>
<span class="blue">   ┌─</span> app.volt:10:30
<span class="blue">   │</span>
<span class="blue"> 9 │</span>     val n = consume(items);
<span class="blue">   │</span>                     <span class="blue">----- moved here</span>
<span class="blue">10 │</span>     std::println("&#123;&#125; &#123;&#125;", n, items.len);
<span class="blue">   │</span>                              <span class="err">^^^^^</span>
<b class="err">error</b><b>: point has no field 'z'</b>
<span class="blue">  ┌─</span> app.volt:5:19
<span class="blue">  │</span>
<span class="blue">5 │</span>     val d = p.x + p.z;
<span class="blue">  │</span>                   <span class="err">^^^</span>
<span class="blue">  │</span>
<span class="blue">  =</span> <b>help</b>: did you mean 'x'?</pre>
          </div>
        </div>
      </section>

      <section class="bolt reveal">
        <div class="split reverse">
          <div class="stack">
            <div class="window term">
              <div class="window-bar"><i></i><i></i><i></i><span>terminal</span></div>
              <pre class="typing"><span class="line l1"><span class="prompt">$</span> bolt new hello</span><span class="line l2 dim">     Created binary (application) package `hello`</span><span class="line l3"><span class="prompt">$</span> cd hello &amp;&amp; bolt run --release</span><span class="line l4 dim">   Compiling std</span><span class="line l5 dim">   Compiling hello v0.1.0 (bin "hello")</span><span class="line l6 dim">    Finished `release` profile [optimized] target(s) in 0.42s</span><span class="line l7">hello from hello</span></pre>
            </div>
            <div class="window">
              <div class="window-bar"><i></i><i></i><i></i><span>bolt.toml</span></div>
              <Code code={boltToml} lang="toml" theme="tokyo-night" />
            </div>
          </div>
          <div>
            <h2>bolt builds it</h2>
            <p class="section-lede">
              Cargo's workflow without a registry: packages and workspaces, path and git dependencies pinned in a lock
              file, features, profiles, tests, benches, and build files written in Volt. Libraries compile once per
              profile and in parallel.
            </p>
            <a class="more" href={doc("bolt/overview")}>The bolt book →</a>
          </div>
        </div>
      </section>

      <section class="interop reveal">
        <h2>Speaks C, and everything that does</h2>
        <p class="section-lede">Volt meets other languages at the C ABI in both directions, reads C++ headers itself, and builds Rust, Zig and Go code for you.</p>
        <div class="hub">
          <div class="hub-top">
            <svg viewBox="0 0 600 260" class="hub-lines" aria-hidden="true">
              {[5, 3].map((cols) =>
                Array.from({ length: cols }, (_, i) => {
                  const x = ((i + 0.5) * 600) / cols;
                  return <path d={`M300 110 C 300 190 ${x} 170 ${x} 258`} class={`spoke cols-${cols}`} style={`--i:${i}`} />;
                }),
              )}
            </svg>
            <div class="hub-center">volt</div>
          </div>
          <div class="hub-langs">
            {languages.map((l) => <span>{l}</span>)}
          </div>
        </div>
        <div class="interop-notes">
          <p><b>In:</b> <code>use &#123; "stdio.h" &#125; as c;</code> imports functions, structs, unions, constants and globals from real C headers. <code>use cpp &#123; "lib.hpp" &#125;</code> brings classes, overloads, templates and the standard library, <code>use rust &#123; "geom" &#125;</code> and <code>use zig &#123; "math.zig" &#125;</code> an ordinary Rust crate's or Zig file's public API, and bolt's <code>[foreign]</code> table builds Go modules for you.</p>
          <p><b>Out:</b> <code>export fn</code> makes C symbols; <code>voltc lib --shared</code> builds a library, and <code>bindings</code> in <code>bolt.toml</code> writes (and builds) its bindings for every language above.</p>
        </div>
      </section>

      <section class="editors reveal">
        <div class="split">
          <div>
            <h2>At home in your editor</h2>
            <p class="section-lede">
              <code>voltc lsp</code> is a language server built on the compiler itself: diagnostics as you type, hover, go to
              definition, references, completion and signature help. The VS Code extension adds highlighting, snippets
              and bolt tasks.
            </p>
            <a class="more" href={doc("editors/vscode")}>Set up your editor →</a>
          </div>
          <div class="window editor">
            <div class="window-bar"><i></i><i></i><i></i><span>main.volt</span></div>
            <pre class="mock"><span class="k">fn</span> <span class="f">main</span>() -&gt; <span class="t">void</span> &#123;
    <span class="k">val</span> total = <span class="f hovered">add</span>(<span class="n">1</span>, <span class="n">2</span>);
    std::<span class="f">println</span>(<span class="s">"&#123;&#125;"</span>, total);
&#125;</pre>
            <div class="hover-card"><code>fn add(a: i32, b: i32) -&gt; i32</code></div>
          </div>
        </div>
      </section>

      <section class="final reveal">
        <h2>Write some Volt</h2>
        <p class="section-lede">Build the compiler, run the tour, and read the guide. It's one afternoon from zero to your first program.</p>
        <div class="cta">
          <a class="btn primary" href={doc("start/install")}>Install</a>
          <a class="btn ghost" href={doc("guide/basics")}>Language guide</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>Volt is licensed under MIT or Apache-2.0.</span>
      <span><a href={doc("start/install")}>Docs</a> · <a href={doc("internals/architecture")}>Internals</a> · <a href="https://github.com/ChaseSunstrom/volt-bootstrap">GitHub</a></span>
    </footer>

    <script>
      // reveal sections as they scroll in (everything is visible without JS or with reduced motion)
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-reveal");
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("shown");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
