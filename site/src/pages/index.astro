---
// The landing page: a Starlight page (so it shares the docs' header, search and theme) with its own
// sections. Code samples are the programs in src/samples, which tests/docs.rs compiles and runs;
// their `// expect:` lines are the output shown. The benchmark bars come from the table in
// internals/benchmarks.md, which a benchmark run rewrites.
//
// The page is one circuit. On load the mark draws itself and its spark lights, and current runs
// from main.volt to the C (or LLVM IR) voltc writes for it and on to what it prints. From the
// mark's spark one trace runs down the page to the last terminal, and scrolling carries a spark
// along it (src/scripts/current.ts): headings fill with light as it passes, the runtime's parts
// switch off, the benchmark bars charge, current runs through the languages Volt calls and that
// call it, and the first command types itself. With reduced motion everything is shown in its
// final state.
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Code } from "astro:components";
import { volt, codeDark } from "../code-themes.mjs";
import * as mark from "../mark";
import "../styles/landing.css";
import heroSrc from "../samples/hero.volt?raw";
// what voltc writes for the hero program, excerpts that tests/docs.rs finds in `voltc emit-c` and
// `voltc emit-llvm` (a debug build)
import heroC from "../samples/hero.c.txt?raw";
import heroLlvm from "../samples/hero.ll.txt?raw";
import errorsSrc from "../samples/errors.volt?raw";
import ownershipSrc from "../samples/ownership.volt?raw";
import templatesSrc from "../samples/templates.volt?raw";
import comptimeSrc from "../samples/comptime.volt?raw";
import interopSrc from "../samples/interop.volt?raw";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// the headline, a line at a time, its words numbered for the load sequence
let word = 0;
const headline = ["A systems", "language that", "shows its work."].map((l) => l.split(" ").map((w) => ({ w, i: word++ })));
const doc = (path: string) => `${base}/${path}/`;

// a sample's code (without its expect lines) and its output
function sample(src: string) {
  const lines = src.trimEnd().split("\n");
  const output = lines.filter((l) => l.startsWith("// expect:")).map((l) => l.slice("// expect:".length).trim());
  const code = lines.filter((l) => !l.startsWith("// expect:")).join("\n").trimEnd();
  return { code, output };
}

const hero = sample(heroSrc);

const tabs = [
  {
    id: "errors",
    label: "Errors",
    title: "Errors are values",
    text: "A function that can fail returns E!T: an error from the set E, or a T. try passes an error up, catch handles it. Optionals (T?) say a value may be missing, and ?? gives a fallback. Nothing is thrown, nothing unwinds.",
    link: doc("guide/errors"),
    ...sample(errorsSrc),
  },
  {
    id: "ownership",
    label: "Ownership",
    title: "Ownership without a collector",
    text: "Every value has one owner and is deleted when that owner's scope ends, in reverse order. Passing a value moves it (using it afterwards is a compile error); copy makes a second owner.",
    link: doc("guide/ownership"),
    ...sample(ownershipSrc),
  },
  {
    id: "templates",
    label: "Templates",
    title: "Templates and closed traits",
    text: "Generic functions and structs are templates: one copy per set of arguments. A trait used as a type is a tagged union of every type that attaches it, so a call is a switch, never a vtable.",
    link: doc("guide/templates"),
    ...sample(templatesSrc),
  },
  {
    id: "comptime",
    label: "Comptime",
    title: "Code that runs while compiling",
    text: "comptime functions, comptime if, for and match, types as values and @typeinfo. Here fib runs in the compiler, and a pack of arguments unrolls into one print per type.",
    link: doc("guide/comptime"),
    ...sample(comptimeSrc),
  },
  {
    id: "interop",
    label: "C and C++",
    title: "C and C++ headers, imported",
    text: "A use line reads real C headers, and C++ ones through libclang: classes with their layouts, constructors, methods, overloads and templates. Rust and Zig files import the same way.",
    link: doc("interop/cpp"),
    ...sample(interopSrc),
  },
];

// the benchmark table: each program's Volt times as a fraction of C's (clang -O2)
const benchMd = readFileSync(resolve(process.cwd(), "src/content/docs/internals/benchmarks.md"), "utf8");
const ratio = (cell: string) => parseFloat(cell.match(/\(([\d.]+)x\)/)?.[1] ?? "1");
const bench = benchMd
  .split("<!-- bench:start -->")[1]
  .split("<!-- bench:end -->")[0]
  .split("\n")
  .filter((l) => /^\| [a-z0-9_]+ \|/.test(l))
  .map((l) => {
    const cells = l.split("|").map((c) => c.trim());
    return { name: cells[1], c: ratio(cells[5]), llvm: ratio(cells[6]) };
  });
const scale = 1.4; // the bar area spans 0x to 1.4x of C's time
const pct = (r: number) => `${(Math.min(r, scale) / scale) * 100}%`;

// what a program carries in other languages, and Volt leaves out
const parts = ["Garbage collector", "Exceptions and unwinding", "Virtual tables", "Runtime type information", "Hidden allocations"];

const imports = [
  { lang: "C", line: 'use { "stdio.h" } as c;' },
  { lang: "C++", line: 'use { "shapes.hpp" } as shapes;' },
  { lang: "Rust", line: 'use { "geom.rs" } as geom;' },
  { lang: "Zig", line: 'use { "fastmath.zig" } as fm;' },
];
const callers = ["C", "C++", "Rust", "Zig", "Go", "Python", "JavaScript", "TypeScript", "Lua", "Ruby", "Java", "Kotlin", "C#", "Dart", "Swift"];
// the callers in rows of three; a wire runs from Volt to each row
const callerRows = [0, 3, 6, 9, 12].map((i) => callers.slice(i, i + 3));
// a wire from (0, y0) to (100, y1) in a 100×100 box, leaving and arriving level
const wire = (y0: number, y1: number) => `M0 ${y0} C 55 ${y0}, 45 ${y1}, 100 ${y1}`;
const rowY = (i: number, n: number) => ((i + 0.5) / n) * 100;

const spec = [
  { term: "No runtime", text: "No collector, no scheduler, no vtables, no exceptions. A Volt program is the code you wrote and the standard library you called." },
  { term: "Two backends", text: "Readable C that any C compiler builds, or native code through LLVM. A library from one links with a program from the other." },
  { term: "Checked in debug", text: "Overflow, out-of-bounds indexing, null unwraps and double frees stop with a message and the line. Release builds drop the checks." },
  { term: "Ownership", text: "Deletes run at scope end, moves are tracked, copies are explicit, and box<T> owns heap memory. No annotations." },
  { term: "Comptime", text: "Run code in the compiler, pass types around as values, and read any type's shape with @typeinfo." },
  { term: "Async", text: "Stackless frames of known size, driven with async, resume and await. No heap and no executor." },
  { term: "bolt", text: "The build tool: packages, workspaces, git dependencies, features, profiles, tests, benchmarks and a profiler." },
  { term: "Tooling", text: "A language server built on the compiler, a VS Code extension, and diagnostics that show the code and suggest the fix." },
  { term: "Self-hosted", text: "voltc is written in Volt and builds itself, byte for byte, through both backends." },
  { term: "Bare metal", text: "--target builds for a microcontroller with no C compiler and no C library: start code from voltc, std's runtime in Volt." },
];

---

<StarlightPage
  frontmatter={{
    title: "Volt",
    description: "Volt is a compiled systems language with no runtime: ownership instead of a garbage collector, errors as values, templates, comptime, and direct calls into C, C++, Rust and Zig. It compiles to readable C or through LLVM.",
    template: "splash",
    pagefind: false,
    editUrl: false,
    lastUpdated: false,
    prev: false,
    next: false,
    tableOfContents: false,
    // before the first paint: the hero's load sequence runs once per visit to this page
    head: [
      {
        tag: "script",
        content: 'if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.dataset.intro = "";',
      },
    ],
  }}
>
  <div class="landing not-content">
    <section class="hero">
      <div class="hero-text">
        <h1>{headline.map((line) => <span class="ln">{line.map((x) => <><span class="w" style={`--i:${x.i}`}>{x.w}</span>{" "}</>)}</span>)}</h1>
        <svg class="hero-mark" viewBox="0 22 100 56" aria-hidden="true">
          <path class="trace" d={mark.trace} pathLength="1" />
          <path class="pulse" d={`${mark.trace} L ${mark.cx} ${mark.cy}`} pathLength="1" />
          <circle class="ring burst" cx={mark.cx} cy={mark.cy} r={mark.r} />
          <circle class="ring burst" cx={mark.cx} cy={mark.cy} r={mark.r} />
          <circle class="ring flash" cx={mark.cx} cy={mark.cy} r={mark.r} />
          <circle class="spark" cx={mark.cx} cy={mark.cy} r={mark.r} />
        </svg>
        <p class="lede">
          Volt has no runtime. It gives you ownership instead of a garbage collector, errors as values, templates and
          compile-time code, and it compiles to C you can read or to native code through LLVM.
        </p>
        <div class="actions">
          <a class="button primary" href={doc("start/install")}>Install Volt</a>
          <a class="button" href={doc("start/tour")}>Take the tour</a>
        </div>
      </div>

      <div class="circuit" aria-label="A Volt program, the C voltc writes for it, and what it prints">
        <figure class="stage stage-src">
          <figcaption><span class="dot"></span>main.volt</figcaption>
          <Code code={hero.code} lang={volt} theme={codeDark} />
        </figure>

        <div class="wire w1" aria-hidden="true"></div>

        <figure class="stage stage-out">
          <input type="radio" name="backend" id="be-c" checked />
          <input type="radio" name="backend" id="be-llvm" />
          <figcaption>
            <span class="dot"></span>
            <span class="switch" role="group" aria-label="Backend">
              <label for="be-c">main.c</label>
              <label for="be-llvm">LLVM IR</label>
            </span>
          </figcaption>
          <div class="out out-c"><Code code={heroC.trimEnd()} lang="c" theme={codeDark} /></div>
          <div class="out out-llvm"><Code code={heroLlvm.trimEnd()} lang="llvm" theme={codeDark} /></div>
        </figure>

        <div class="wire w2" aria-hidden="true"></div>

        <figure class="stage stage-term">
          <figcaption><span class="dot"></span>terminal</figcaption>
          <pre><span class="cmd"><span class="prompt">$</span> <span class="typed" style="--n:19">voltc run main.volt</span></span>
<span class="result">{hero.output.join("\n")}</span></pre>
        </figure>
      </div>
    </section>

    <section class="norun">
      <div class="norun-text">
        <h2 class="charge">Nothing runs underneath</h2>
        <p>
          Volt programs carry no machinery you didn't ask for. What a line does is what it says, and the C it becomes is
          there to read.
        </p>
      </div>
      <ul class="breakers">
        {parts.map((p) => (
          <li>
            <span class="part">{p}</span>
            <span class="toggle" aria-hidden="true"><span class="knob"></span></span>
            <span class="state">none</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="samples">
      <h2 class="charge">Read some Volt</h2>
      <p class="sub">Every program here is real: the site's tests compile and run each one and check what it prints.</p>
      <div class="tabs">
        {tabs.map((t, i) => <input type="radio" name="sample" id={`s-${t.id}`} checked={i === 0} />)}
        <div class="tab-labels">
          {tabs.map((t) => <label for={`s-${t.id}`}>{t.label}</label>)}
        </div>
        {tabs.map((t) => (
          <div class={`panel panel-${t.id}`}>
            <Code code={t.code} lang={volt} theme={codeDark} />
            <div class="panel-text">
              <h3>{t.title}</h3>
              <p>{t.text}</p>
              <pre class="printed">{t.output.map((l, i) => <span style={`--i:${i}`}>{l}{"\n"}</span>)}</pre>
              <a href={t.link}>Read the guide</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bench">
      <div class="bench-text">
        <h2 class="charge">Measured against C</h2>
        <p>
          Each program runs in C, in C++ and in Volt through both backends. A bar is Volt's time as a share of the C
          program's, and the line marks C. Where Volt is faster, it's for a reason you can read: free lists in the default
          allocator, sorting by template instead of a function pointer, Ryu for printing floats.
        </p>
        <a href={doc("internals/benchmarks")}>The programs, the machine and every number</a>
      </div>
      <div class="chart" role="table" aria-label="Volt's time as a share of C's, per benchmark" style={`--c:${pct(1)}`}>
        <div class="chart-head" role="row">
          <span role="columnheader">Program</span>
          <span role="columnheader">C backend</span>
          <span role="columnheader">LLVM</span>
        </div>
        {bench.map((b) => (
          <div class="chart-row" role="row">
            <span class="prog" role="rowheader">{b.name}</span>
            <span class="bar-cell" role="cell">
              <span class="track"><span class="bar" style={`--w:${pct(b.c)}`} data-faster={b.c < 0.97 ? "" : undefined}></span></span>
              <span class="num">{b.c.toFixed(2)}×</span>
            </span>
            <span class="bar-cell" role="cell">
              <span class="track"><span class="bar" style={`--w:${pct(b.llvm)}`} data-faster={b.llvm < 0.97 ? "" : undefined}></span></span>
              <span class="num">{b.llvm.toFixed(2)}×</span>
            </span>
          </div>
        ))}
      </div>
    </section>

    <section class="interop">
      <h2 class="charge">Calls everything, and everything calls it</h2>
      <p class="sub">
        A use line reads another language's code like a header; the extension says which language. And a Volt library
        builds as a shared library, with bindings bolt writes for each of these.
      </p>
      <div class="network">
        <ul class="imports">
          {imports.map((i, k) => <li style={`--i:${k}`}><span class="lang">{i.lang}</span><code>{i.line}</code></li>)}
        </ul>
        <svg class="wires wires-in" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {imports.map((_, k) => (
            <g style={`--i:${k}`}>
              <path class="track" d={wire(rowY(k, imports.length), 50)} />
              <path class="pulse" d={wire(rowY(k, imports.length), 50)} pathLength="1" />
            </g>
          ))}
        </svg>
        <div class="hub">
          <svg viewBox="0 22 100 56" aria-hidden="true">
            <path class="hub-trace" d={mark.trace} />
            <circle class="hub-spark" cx={mark.cx} cy={mark.cy} r={mark.r} />
          </svg>
          <span>volt</span>
        </div>
        <svg class="wires wires-out" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {callerRows.map((_, k) => (
            <g style={`--i:${k}`}>
              <path class="track" d={wire(50, rowY(k, callerRows.length))} />
              <path class="pulse" d={wire(50, rowY(k, callerRows.length))} pathLength="1" />
            </g>
          ))}
        </svg>
        <ul class="callers" aria-label="Languages that call Volt libraries">
          {callerRows.map((row, k) => (
            <li style={`--i:${k}`}>{row.map((l) => <span>{l}</span>)}</li>
          ))}
        </ul>
      </div>
      <a href="https://github.com/ChaseSunstrom/volt-bootstrap/tree/main/examples/interop">A runnable example for each language</a>
    </section>

    <section class="spec">
      <h2 class="charge">What's in it</h2>
      <dl>
        {spec.map((s) => <div><dt class="charge">{s.term}</dt><dd>{s.text}</dd></div>)}
      </dl>
    </section>

    <section class="start">
      <h2 class="charge">Write your first program</h2>
      <p>Build the compiler, then let bolt make a package and run it.</p>
      <pre class="shell"><span class="prompt">$</span> <span class="typed" style="--n:38">bolt new hello && cd hello && bolt run</span>
<span class="shell-out"><span class="line" style="--i:0">     Created binary (application) package `hello`
</span><span class="line" style="--i:1">   Compiling std (~/volt/std)
</span><span class="line" style="--i:2">   Compiling hello v0.1.0 (bin "hello")
</span><span class="line" style="--i:3">    Finished `dev` profile [unoptimized] target(s) in 0.66s
</span><span class="line" style="--i:4">     Running `target/debug/hello`
</span><span class="line said" style="--i:5">hello from hello
</span></span></pre>
      <div class="actions">
        <a class="button primary" href={doc("start/install")}>Install Volt</a>
        <a class="button" href={doc("guide/basics")}>Read the guide</a>
      </div>
    </section>

    <footer class="foot">
      <span>Volt is licensed under MIT or Apache-2.0.</span>
      <a href="https://github.com/ChaseSunstrom/volt-bootstrap">Source on GitHub</a>
    </footer>
  </div>
  <script>
    import "../scripts/current.ts";
  </script>
</StarlightPage>
