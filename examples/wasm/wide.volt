// 128-bit arithmetic in a module: what LLVM leaves to compiler-rt's routines on WebAssembly
// (std/bare.volt's wide128) gives what it gives natively
use std::io;
fn id(x: i128) -> i128 { return x; }
fn sh(x: i32) -> i32 { return x; }
fn f(x: f64) -> f64 { return x; }
fn main() -> void {
    val a = id(170141183460469231731687303715884105727);
    val b = id(-12345678901234567890123456789);
    val c = id(98765432109876543210);
    std::println("{} {} {}", c *% 1000003, b / 7, b % 7);
    std::println("{} {} {}", c / -3, -c % 1000, a / c);
    val shifts: i32[7] = { 0, 1, 63, 64, 65, 100, 127 };
    for (s) in shifts {
        std::println("{} {} {}", c << sh(s) % 128, a >> sh(s), b >> sh(s));
    }
    val u: u128 = @cast<u128>(id(-1));
    std::println("{} {} {}", u / 3, u % 1000000007, u >> sh(70));
    std::println("{} {} {} {}", @cast<f64>(c), @cast<f64>(b), @cast<f64>(u), @cast<f32>(c));
    std::println("{} {} {}", @cast<i128>(f(1.0e30)), @cast<i128>(f(-123456789012345678.0)), @cast<u128>(f(3.0e38)));
    std::println("{}", c * 3);
}

