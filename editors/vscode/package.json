{
  "name": "volt-lang",
  "displayName": "Volt",
  "description": "Volt language support: semantic highlighting, inlay hints, code lenses, diagnostics with quick fixes, hover, go to definition, references, rename, completion and bolt tasks",
  "version": "0.1.0",
  "publisher": "volt-lang",
  "license": "(MIT OR Apache-2.0)",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E1B4B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChaseSunstrom/volt-bootstrap"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "volt",
    "bolt",
    "language server"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/bolt.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "volt",
        "aliases": [
          "Volt",
          "volt"
        ],
        "extensions": [
          ".volt"
        ],
        "icon": {
          "light": "./images/volt-file.svg",
          "dark": "./images/volt-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "volt",
        "scopeName": "source.volt",
        "path": "./syntaxes/volt.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "volt",
        "path": "./snippets/volt.json"
      }
    ],
    "configuration": {
      "title": "Volt",
      "properties": {
        "volt.serverPath": {
          "type": "string",
          "default": "voltc",
          "description": "The voltc to run as the language server (`voltc lsp`): a path, or a name on PATH."
        },
        "volt.stdPath": {
          "type": "string",
          "default": "",
          "description": "The std package to check against (voltc --std). Empty: voltc finds it ($VOLT_STD, or next to voltc)."
        },
        "volt.boltPath": {
          "type": "string",
          "default": "bolt",
          "description": "The bolt that runs build, run, test and check tasks."
        },
        "volt.inlayHints.types": {
          "type": "boolean",
          "default": true,
          "description": "Show the type of a val/var (or for/match binding) that doesn't write one."
        },
        "volt.inlayHints.parameters": {
          "type": "boolean",
          "default": true,
          "description": "Show which parameter each call argument is for (not for one-letter parameters, nor where the argument names it already)."
        },
        "volt.inlayHints.closingBraces": {
          "type": "boolean",
          "default": true,
          "description": "Show what a long block (25 lines or more) closes after its }: fn main, struct point..."
        }
      }
    },
    "commands": [
      {
        "command": "volt.restartServer",
        "title": "Volt: Restart Language Server"
      },
      {
        "command": "volt.run",
        "title": "Volt: Run This Program"
      },
      {
        "command": "volt.expand",
        "title": "Volt: Expand Comptime"
      }
    ],
    "taskDefinitions": [
      {
        "type": "bolt",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The bolt command: build, run, test, check, clean..."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "More arguments for bolt (--release, -p NAME...)"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "volt",
        "owner": "volt",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning): (.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*┌─ (.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p .",
    "build": "tsc -p .",
    "test": "vscode-tmgrammar-test 'tests/grammar/*.test.volt' && vscode-tmgrammar-snap 'tests/snap/*.volt' && node --test tests/*.test.js",
    "install-extension": "vsce package -o volt.vsix && code --install-extension volt.vsix",
    "test:e2e": "node tests/e2e/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.0",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
